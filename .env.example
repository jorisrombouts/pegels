# Neon Postgres connection string. Copy this file to `.env.local` and paste your
# Neon database URL below. Find it in the Neon console → your project → "Connection string"
# (use the pooled connection string; it looks like the line below).
#
#   cp .env.example .env.local
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
