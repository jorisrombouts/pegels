# Copy this file to `.env.local` and fill in the values:  cp .env.example .env.local

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Neon console → your project → "Connection string"
# (use the pooled string ending in `-pooler`).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used to categorize imported transactions (gpt-4o-mini). Required: there is no
# fallback — without a valid key, import fails visibly rather than guessing.
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ── Auth (Auth.js v5 + Google) ────────────────────────────────────────────────
# Session encryption secret. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="..."

# Google OAuth client (Google Cloud console → APIs & Services → Credentials → OAuth client).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google  (+ your prod URL).
AUTH_GOOGLE_ID="...apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="..."

# Single-owner allowlist (fail-closed): only this Google account may sign in.
OWNER_EMAIL="you@example.com"

# ── Local dev only ────────────────────────────────────────────────────────────
# Skips Google sign-in locally and runs as this user id. Leave UNSET in production.
# Pair with a seeded dev DB (npm run db:seed) so you don't touch real data.
DEV_USER_ID="user-stub"
